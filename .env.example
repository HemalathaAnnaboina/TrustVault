# ====================================================================
# TrustVault Environment Variables Template (Development & Production)
# ====================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Relational Database Connection (PostgreSQL Production / Local)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/trustvault_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Secret (MUST be at least 256 bits / 32 bytes long for HMAC-SHA256)
TRUSTVAULT_JWT_SECRET=ReplaceWithAStrongCryptographicRandomSecretKeyOfAtLeast32BytesLength!
TRUSTVAULT_JWT_EXPIRATION_MS=86400000

# Private Document Vault Storage
TRUSTVAULT_STORAGE_PATH=./data/vault
TRUSTVAULT_STORAGE_MAX_FILE_SIZE=52428800
TRUSTVAULT_DOWNLOAD_TOKEN_EXPIRATION_SECONDS=60

# Rate Limiting
TRUSTVAULT_RATE_LIMIT_LOGIN_PER_MINUTE=10

# Next.js Frontend (runs on port 3000)
NEXT_PUBLIC_API_URL=http://localhost:8080/api
